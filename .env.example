# ============================================================
# AK NAZAR CYBER CAFE ERP - Environment configuration
# Copy this file to .env and fill real values.
# NEVER commit the real .env to version control.
# ============================================================

# Django runtime settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.monkeycode-ai.live
# Comma-separated origins allowed to POST (CSRF). Defaults to the preview
# domain in development. Production MUST set its own public origins, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.aknazar.in
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (development: SQLite; production: PostgreSQL) ---
# For PostgreSQL uncomment and set:
# DB_ENGINE=django.db.backends.postgresql
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Superuser bootstrap (optional, used by create_superuser command) ---
# DJANGO_SUPERUSER_USERNAME=owner
# DJANGO_SUPERUSER_EMAIL=owner@aknazar.com
# DJANGO_SUPERUSER_PASSWORD=change-me
